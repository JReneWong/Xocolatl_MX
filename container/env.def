Bootstrap: docker
From: ubuntu:22.04
Stage: build

%files
    container/env.yaml /opt/env.yaml

%post
    export DEBIAN_FRONTEND=noninteractive
    # git: needed by the pip `git+https://...` dependency in env.yaml.
    apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates bzip2 git \
    && rm -rf /var/lib/apt/lists/*

    case "$(uname -m)" in
        aarch64) MICROMAMBA_ARCH=linux-aarch64 ;;
        x86_64)  MICROMAMBA_ARCH=linux-64 ;;
        *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
    esac
    curl -Ls "https://micro.mamba.pm/api/micromamba/${MICROMAMBA_ARCH}/latest" | tar -xj -C /usr/local bin/micromamba

    export MAMBA_ROOT_PREFIX=/opt/mamba
    micromamba create -y -p /opt/env -f /opt/env.yaml
    micromamba clean --all --yes

    rm -rf /opt/env/pkgs /opt/env/conda-meta/*.json.bak \
           /opt/env/share/doc /opt/env/share/man /opt/env/share/info
    find /opt/env -name '*.a' -delete

    tar -C /opt -cf /opt/env.tar env


Bootstrap: docker
From: ubuntu:22.04
Stage: final

%files from build
    /opt/env.tar /opt/env.tar

%post
    tar -C /opt -xf /opt/env.tar && rm /opt/env.tar

    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates procps \
    && rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/env/bin:$PATH

%runscript
    echo "Rare Disease Hackathon container. Tools: fastqc, multiqc, bwa, samtools,"
    echo "picard, bcftools, gatk4 (+pytorch/pytorch-lightning/scorevariants for"
    echo "NVScoreVariants), python(pysam/pandas)"
    exec "$@"

%help
    Build (from the repo root):
        apptainer build container/env.sif container/env.def
    Run a shell inside it:
        apptainer shell container/env.sif
    Run a single command:
        apptainer exec container/env.sif samtools --version
