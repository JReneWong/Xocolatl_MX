Bootstrap: docker
From: ubuntu:22.04
Stage: build

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential autoconf automake libtool pkg-config \
        wget curl ca-certificates git tar bzip2 \
        zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev libdeflate-dev \
    && rm -rf /var/lib/apt/lists/*

    HTSLIB_VERSION=1.16
    BOOST_VERSION=1.73.0
    BOOST_VERSION_U=1_73_0

    mkdir -p /opt/src

    # HTSlib
    cd /opt/src
    wget -q "https://github.com/samtools/htslib/releases/download/${HTSLIB_VERSION}/htslib-${HTSLIB_VERSION}.tar.bz2"
    tar -xf "htslib-${HTSLIB_VERSION}.tar.bz2"
    mv "htslib-${HTSLIB_VERSION}" htslib
    cd htslib
    make

    # Boost
    cd /opt/src
    wget -q "https://archives.boost.io/release/${BOOST_VERSION}/source/boost_${BOOST_VERSION_U}.tar.bz2"
    tar --bzip2 -xf "boost_${BOOST_VERSION_U}.tar.bz2"
    cd "boost_${BOOST_VERSION_U}"
    ./bootstrap.sh --with-libraries=iostreams,program_options,serialization --prefix=../boost
    ./b2 install

    # Shapeit5
    cd /opt/src
    git clone --depth 1 --recurse-submodules https://github.com/odelaneau/shapeit.git

    cd /opt/src/shapeit/phase_common
    make HTSSRC=/opt/src/htslib \
        HTSLIB_INC=/opt/src/htslib \
        HTSLIB_LIB=/opt/src/htslib/libhts.a \
        BOOST_INC=/opt/src/boost/include \
        BOOST_LIB_IO=/opt/src/boost/lib/libboost_iostreams.a \
        BOOST_LIB_PO=/opt/src/boost/lib/libboost_program_options.a \
        BOOST_LIB_SE=/opt/src/boost/lib/libboost_serialization.a
    
    cd /opt/src/shapeit/phase_rare
    make HTSSRC=/opt/src/htslib \
        HTSLIB_INC=/opt/src/htslib \
        HTSLIB_LIB=/opt/src/htslib/libhts.a \
        BOOST_INC=/opt/src/boost/include \
        BOOST_LIB_IO=/opt/src/boost/lib/libboost_iostreams.a \
        BOOST_LIB_PO=/opt/src/boost/lib/libboost_program_options.a \
        BOOST_LIB_SE=/opt/src/boost/lib/libboost_serialization.a

%environment
    export LC_ALL=C


Bootstrap: docker
From: ubuntu:22.04
Stage: final

%files from build
    /opt/src/shapeit/phase_common/bin/* /usr/local/bin/
    /opt/src/shapeit/phase_rare/bin/* /usr/local/bin/
    /opt/src/shapeit/resources/maps/b38 /usr/local/share/shapeit/maps/b38

%post
    apt-get update && apt-get install -y --no-install-recommends \
        libcurl4 libssl3 zlib1g libbz2-1.0 liblzma5 libdeflate0 \
    && rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C

%runscript
    echo "SHAPEIT container. Tools: phase_common, phase_rare"
    exec "$@"
