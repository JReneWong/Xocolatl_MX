# Data — never commit, each teammate downloads independently. Anchored to
# repo root (leading /) — a bare "data/" would also match every module's
# 00N_Module/data/ (a real directory here, holding just a documentation
# stub — see the note below), which is a different thing entirely and
# needs to stay tracked.
/data/
InitialData/
*.fastq.gz
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bam
*.bai
*.cram
*.fasta
*.fa
*.fa.fai
references/

# Container images — rebuild locally, don't version large binaries
*.sif
*.img

# Challenge/organizer materials tied to the dataset — treat like input data,
# each teammate keeps their own local copy instead of versioning it.
Challenge_*.docx

# Top-level results/ — final deliverable rollups only (small tables/figures
# for the write-up), not per-module working output. See pipeline/ below for
# that.
results/*
!results/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
env/

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/

# Nextflow
.nextflow/
.nextflow.log*
work/