params {
    outdir = "${launchDir}/results"

    // References
    genome = "${launchDir}/data/references/genome/"
}

process {
    withName: fastqc {
        memory = '2.GB'
        cpus = 2
    }

    withName: multiqc {
        memory = '2.GB'
        cpus = 2
    }

    withName: alignment {
        memory = '4.GB'
        cpus = 2
    }

    memory = '2.GB'
    cpus = 2
}

profiles {
    apptainer {
        apptainer.enabled = true
        process {
            container = "file:///${launchDir}/container/hackathon.sif"
        }
    }

    micromamba {
        conda.enabled = true
        conda.useMicromamba = true
        process {
            conda = "${launchDir}/container/env.yaml"
        }
    }

    conda {
        conda.enabled = true
        process {
            conda = "${launchDir}/container/env.yaml"
        }
    }
    
}

// Uncomment to automatically remove intermediate files in work dir
// cleanup = true
