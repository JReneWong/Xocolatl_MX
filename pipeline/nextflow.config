params {
    outdir = "${launchDir}/results"

    // References
    ref_genome_dir = "${launchDir}/data/references/genome"
    ref_genome_file = "Homo_sapiens_assembly38.fasta"
    dbsnp_dir = "${launchDir}/data/references/dbsnp"
    dbsnp_file = "Homo_sapiens_assembly38.dbsnp138.vcf.gz"
    known_sites_dir = "${launchDir}/data/references/known_sites"
    known_indels_file = "Homo_sapiens_assembly38.known_indels.vcf.gz"
    mills_file = "Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
}

process {
    withName: fastqc {
        memory = '2.GB'
        cpus = 2
    }

    withName: multiqc {
        memory = '2.GB'
        cpus = 2
    }

    withName: alignment {
        memory = '4.GB'
        cpus = 4
    }

    memory = '2.GB'
    cpus = 2
}

profiles {
    apptainer {
        apptainer.enabled = true
        process {
            container = "file:///${launchDir}/container/hackathon.sif"
        }
    }

    micromamba {
        conda.enabled = true
        conda.useMicromamba = true
        process {
            conda = "${launchDir}/container/env.yaml"
        }
    }

    conda {
        conda.enabled = true
        process {
            conda = "${launchDir}/container/env.yaml"
        }
    }
    
}

// Uncomment to automatically remove intermediate files in work dir
// cleanup = true
