params {
    outdir = "${launchDir}/results"

    fastq_samplesheet = "${launchDir}/data/fastq/samplesheet.csv"
    vcf_samplesheet = "${launchDir}/data/vcf/samplesheet.csv"

    phasing_samplesheet = "${launchDir}/data/phasing/samplesheet.csv"

    // Dataset
    platform = "ILLUMINA"

    // References
    ref_genome_dir = "${launchDir}/data/references/genome"
    ref_genome_file = "Homo_sapiens_assembly38.fasta"
    dbsnp_dir = "${launchDir}/data/references/dbsnp"
    dbsnp_file = "Homo_sapiens_assembly38.dbsnp138.vcf.gz"
    known_sites_dir = "${launchDir}/data/references/known_sites"
    known_indels_file = "Homo_sapiens_assembly38.known_indels.vcf.gz"
    mills_file = "Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    hapmap_file = "HapMap_3.3.hg38.vcf.gz"
    gnomad_dir = "${launchDir}/data/references/gnomad"
    gnomad_file = "gnomad.genomes.v3.1.2.sites.vcf.bgz"
    clinvar_dir = "${launchDir}/data/references/clinvar"
    clinvar_file = "clinvar_GRCh38.vcf.gz"
    vep_cache_dir = "${launchDir}/data/references/vep_cache"
    vep_cache_file = "homo_sapiens_vep_116_GRCh38.tar.gz"

    chrom_map = "${launchDir}/data/references/chrom_map.tsv"

    exomiser_dir = "${launchDir}/data/references/exomiser/exomiser-cli-15.1.0"
    exomiser_config = "${launchDir}/data/references/exomiser/application.properties"

    optical_dup_pixel_dist = 2500 // Broad's guidance for patterned flow cells

    nvscore = [
        snp_tranche: 99.95,
        indel_tranche: 99.4
    ]

    vep = [
        // Matching reference data
        cache_version: "116",
        assembly: "GRCh38",
        species: "homo_sapiens"
    ]

    af_threshold = 0.001

    exomiser_output_options = [
        numGenes: 10,
        outoutputContributingVariantsOnly: true,
        outputFormats: ["HTML", "JSON"]
    ]
}

process {
    withName: fastqc {
        memory = '4.GB'
        cpus = 4
    }

    withName: multiqc {
        memory = '4.GB'
        cpus = 4
    }

    withName: alignment {
        memory = '12.GB'
        cpus = 8
    }

    withName: haplotype {
        memory = '12.GB'
        cpus = 8
    }

    withName: vep_annotation {
        memory = '12.GB'
        cpus = 8
    }

    memory = '8.GB'
    cpus = 8
}

profiles {
    apptainer {
        apptainer.enabled = true
        process {
            withLabel: shapeit {
                container = "file:///${launchDir}/container/shapeit.sif"
            }
            withName: vep_annotation {
                container = "file:///${launchDir}/container/vep.sif"
            }
            withName: rank_variants {
                container = "file:///${launchDir}/container/exomiser.sif"
            }

            container = "file:///${launchDir}/container/env.sif"
        }
    }

    docker {
        docker.enabled = true
        process {
            withLabel: shapeit {
                container = "shapeit"
            }
        }
    }

    // Note: vep env with conda/micromamba doesn't work on MacOS
    // as of 2026-09 https://github.com/bioconda/bioconda-recipes/issues/61335

    micromamba {
        conda.enabled = true
        conda.useMicromamba = true
        process {
            withName: vep_annotation {
                conda = "${launchDir}/container/vep-env.yaml"
            }
            withName: whatshap_phase {
                conda = "${launchDir}/container/whatshap-env.yaml"
            }
            withName: rank_variants {
                conda = "${launchDir}/container/exomiser-env.yaml"
            }

            conda = "${launchDir}/container/env.yaml"
        }
    }

    conda {
        conda.enabled = true
        process {
            withName: vep_annotation {
                conda = "${launchDir}/container/vep-env.yaml"
            }
            withName: whatshap_phase {
                conda = "${launchDir}/container/whatshap-env.yaml"
            }
            withName: rank_variants {
                conda = "${launchDir}/container/exomiser-env.yaml"
            }

            conda = "${launchDir}/container/env.yaml"
        }
    }
    
}

// Uncomment to automatically remove intermediate files in work dir, but can't use -resume
// cleanup = true
